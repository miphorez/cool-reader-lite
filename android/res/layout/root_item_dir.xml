<?xml version="1.0" encoding="utf-8"?>
<!--
   Recent Book item layout for CR3 root window
-->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/browser_item_body"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:layout_marginEnd="12dip"
    android:gravity="center_horizontal"
    android:minHeight="?android:attr/listPreferredItemHeight"
    android:minWidth="?android:attr/listPreferredItemHeight"
    >

    <ImageView android:id="@+id/item_icon"
        android:src="?attr/cr3_browser_folder_root_drawable"
        android:padding="2dip"
        android:layout_width="@dimen/root_filesystem_icon_size"
        android:layout_height="@dimen/root_filesystem_icon_size"
        android:scaleType="fitCenter"
        android:layout_gravity="center_horizontal|top" 
        />
    
    <TextView android:id="@+id/item_name"
        style="@style/TextAppearance.Small"
        android:text="/mnt/sdcard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:singleLine="true"
        android:ellipsize="start"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal|bottom"
        android:minWidth="?android:attr/listPreferredItemHeight"
        />

</LinearLayout>
