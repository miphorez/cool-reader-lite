<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/base_dialog"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:minWidth="1200dip"
    android:layout_height="fill_parent">
	<LinearLayout 
        android:id="@+id/base_dlg_button_panel"
	    android:layout_width="fill_parent"
	    android:layout_height="wrap_content"
	    android:minHeight="?android:attr/listPreferredItemHeight"
        android:minWidth="?android:attr/listPreferredItemHeight"
	    android:gravity="center_vertical"
        android:paddingStart="0dp"
        android:paddingEnd="0dp">

        <ImageButton
            android:id="@+id/base_dlg_btn_back"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:layout_gravity="center_vertical"
            android:background="@null"
            android:contentDescription="@string/dlg_button_back"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="?attr/cr3_button_prev_drawable" />
        <TextView android:id="@+id/base_dlg_title"
            style="@style/TextAppearance.Medium"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:textColor="?attr/textColorToolBarLabel"
            android:text="Test"/>
        <ImageButton android:id="@+id/base_dlg_btn_positive"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:layout_gravity="center_vertical"
            android:src="?attr/cr3_button_ok_drawable"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:background="@null"
            android:contentDescription="@string/dlg_button_ok"/>
        <ImageButton android:id="@+id/base_dlg_btn_negative"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:layout_gravity="center_vertical"
            android:src="?attr/cr3_button_cancel_drawable"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:background="@null"
            android:contentDescription="@string/dlg_button_cancel"/>
    </LinearLayout>
    <FrameLayout android:id="@+id/base_dialog_content_view"
        android:gravity="top"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_weight="100"
        android:layout_marginLeft="0dip"
        android:layout_marginRight="0dip">
    </FrameLayout>
</LinearLayout>
